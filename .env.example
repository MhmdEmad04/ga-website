# Local development, one Node process only. Run npm run setup:local first.
GARBALIA_LOCAL_DATABASE=1
GARBALIA_DATA_DIR=.data/store
APP_URL=http://127.0.0.1:3000
# For a hosted Postgres/Supabase connection, disable the local database and set
# the private server connection string. Never prefix it with NEXT_PUBLIC_.
# DATABASE_URL=postgresql://...
# TRUST_PROXY=1 only behind a proxy that replaces incoming forwarding headers.
# ADMIN_EMAIL=owner@example.com

# Order notifications: pending jobs are saved even before bot setup.
# Use an empty value to disable notifications for new orders.
ORDER_NOTIFICATION_CHANNELS=telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
